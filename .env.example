# Server-only — never prefix with NEXT_PUBLIC_, that inlines the value into
# the client JS bundle. This is the funded testnet account that fee-pays
# wallet creation + payment submission via app/api/relayer/route.ts, so
# users never need their own funded testnet XLM.
#
# Generate + fund a fresh one for your own deploy:
#   stellar keys generate relayer --network testnet
#   stellar keys fund relayer --network testnet
#   stellar keys secret relayer   # paste the output below
RELAYER_SECRET=

# Optional overrides — safe to leave unset, config.ts has sane testnet defaults.
NEXT_PUBLIC_SOROBAN_RPC_URL=
NEXT_PUBLIC_NETWORK_PASSPHRASE=
NEXT_PUBLIC_SITE_URL=
